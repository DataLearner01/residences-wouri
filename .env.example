# Copiez ce fichier en « .env » puis renseignez les valeurs.

# URL publique du site (sert au sitemap, aux balises canonical et hreflang).
SITE_URL=https://residences-wouri.example

# Formulaire de contact : URL du formulaire Formspree (https://formspree.io).
# L'adresse e-mail de réception se règle dans le tableau de bord Formspree ;
# cette variable relie le site à ce formulaire.
# Laissez vide pour le mode démonstration (aucun envoi réel).
PUBLIC_FORM_ENDPOINT=
