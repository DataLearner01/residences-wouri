---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Tone from '../components/Tone.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { fill, href, useT, type Lang } from '../i18n';
import { quote } from '../lib/format';
import realisations from '../content/realisations.json';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}

const { lang, alternates } = Astro.props;
const t = useT(lang);
const r = t.realisations;
const items = [...realisations].sort((a, b) => b.annee - a.annee);
type Kind = Parameters<typeof t.homes>[1];
---

<Base
  lang={lang}
  title={r.metaTitle}
  description={r.metaDescription}
  alternates={alternates}
  waMessage={t.wa.msg.realisations}
  current="realisations"
>
  <PageHead title={r.title} intro={r.intro} />

  <section class="container-page section">
    <div class="grid gap-x-10 gap-y-16 md:grid-cols-2">
      {
        items.map((item) => (
          <article class="relative">
            <Img
              src={item.image}
              alt={item.alt[lang]}
              widths={[480, 800, 1200]}
              sizes="(min-width: 48rem) 46vw, 92vw"
              class="aspect-[3/2] h-auto w-full bg-brume-200 object-cover"
            />
            <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h2 class="h-card">
                {item.programme ? (
                  <a
                    href={href(lang, 'programmes', item.programme)}
                    class="decoration-current decoration-2 underline-offset-4 hover:underline"
                  >
                    {item.nom}
                  </a>
                ) : (
                  item.nom
                )}
              </h2>
              <p class="text-encre-600">{fill(r.deliveredIn, { annee: item.annee })}</p>
            </div>
            <p class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-1 font-medium text-encre-600">
              <span class="flex items-center gap-1.5">
                <Icon name="map-pin" size={16} />
                {item.quartier}, Douala
              </span>
              <span class="flex items-center gap-1.5">
                <Icon name="key-round" size={16} />
                {t.homes(item.nombre, item.genre as Kind)}
              </span>
            </p>
            {
              item.temoignage && (
                <figure class="mt-6 bg-brume p-5 md:p-6">
                  <blockquote class="titre text-[1.15rem] leading-snug">{quote(item.temoignage[lang], lang)}</blockquote>
                  <figcaption class="mt-2 text-sm font-semibold">{item.temoignage.prenom}</figcaption>
                </figure>
              )
            }
          </article>
        ))
      }
    </div>
    <p class="mt-14 text-sm text-encre-600">{r.note}</p>
  </section>

  <section class="bg-brume">
    <div class="container-page section grid items-center gap-9 lg:grid-cols-[1.5fr_1fr] lg:gap-16">
      <div>
        <h2 class="h-section"><Tone text={t.home.ctaTitle} /></h2>
        <p class="lead mt-6 max-w-xl"><Tone text={t.home.ctaText} soft auto /></p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <a href={href(lang, 'programmes')} class="btn btn-primary">{t.home.heroCta}</a>
        <WhatsAppButton message={t.wa.msg.realisations} label={t.wa.write} />
      </div>
    </div>
  </section>
</Base>
