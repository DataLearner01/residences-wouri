---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import LocationMap from '../components/LocationMap.astro';
import ProgrammeCard from '../components/ProgrammeCard.astro';
import SitePlan from '../components/SitePlan.astro';
import StatusBadge from '../components/StatusBadge.astro';
import UnitsTable from '../components/UnitsTable.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config/site';
import { fill, href, tr, useT, type Lang } from '../i18n';
import { eur, fcfa, mapsUrl } from '../lib/format';
import { getProgrammes } from '../lib/content';
import { photo } from '../lib/photos';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
  slug: string;
}

const { lang, alternates, slug } = Astro.props;
const t = useT(lang);
const programmes = await getProgrammes();
const p = programmes.find((x) => x.slug === slug)!;
const others = programmes.filter((x) => x.slug !== slug).slice(0, 3);

const title = fill(t.programme.metaTitle, { nom: p.nom, quartier: p.quartier });
const description = `${tr(p.accroche, lang)} ${tr(p.typologie, lang)}.`;
const waMessage = fill(t.wa.msg.programme, { nom: p.nom });
const visitUrl = `${href(lang, 'contact')}?programme=${p.slug}&visite=1`;
const share = await getImage({ src: photo(p.image), width: 1200, format: 'jpg' });
const abs = (path: string) => new URL(path, Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Residence',
    name: p.nom,
    description: tr(p.accroche, lang),
    url: abs(alternates[lang]),
    image: abs(share.src),
    address: {
      '@type': 'PostalAddress',
      streetAddress: p.quartier,
      addressLocality: site.address.city,
      addressRegion: site.address.region,
      addressCountry: site.address.country,
    },
    geo: { '@type': 'GeoCoordinates', latitude: p.localisation.lat, longitude: p.localisation.lng },
    amenityFeature: p.atouts.map((a) => ({ '@type': 'LocationFeatureSpecification', name: a[lang], value: true })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.nav.home, item: abs(href(lang, 'home')) },
      { '@type': 'ListItem', position: 2, name: t.nav.programmes, item: abs(href(lang, 'programmes')) },
      { '@type': 'ListItem', position: 3, name: p.nom, item: abs(alternates[lang]) },
    ],
  },
];
const h2 = 'h-sub mb-6';
---

<Base
  lang={lang}
  title={title}
  description={description}
  alternates={alternates}
  waMessage={waMessage}
  current="programmes"
  image={share.src}
  schema={schema}
>
  <section>
    <div class="container-page pb-6 pt-28 md:pb-8 md:pt-40">
      <nav aria-label={t.common.breadcrumb} class="text-sm text-encre-600">
        <a href={href(lang, 'programmes')} class="link font-normal">{t.nav.programmes}</a>
        <span aria-hidden="true" class="mx-1.5">/</span>
        <span aria-current="page">{p.nom}</span>
      </nav>
      <div class="mt-8 flex flex-wrap items-center gap-2">
        <StatusBadge lang={lang} statut={p.statut} />
        <span class="pastille">
          <span class:list={['dot', p.disponibles ? 'dot-disponible' : 'dot-vendu']}></span>
          {t.availability(p.disponibles, p.total)}
        </span>
      </div>
      <h1 class="h-page mt-5 max-w-5xl">{p.nom}<span class="ton-clair">, {p.quartier}</span></h1>
      <p class="lead mt-6 max-w-2xl">{tr(p.accroche, lang)}</p>
    </div>
  </section>

  <div class="container-page py-8 md:py-12">
    <Gallery
      lang={lang}
      label={fill(t.programme.galleryLabel, { nom: p.nom })}
      images={p.galerie.map((g) => ({ fichier: g.fichier, alt: tr(g.alt, lang) }))}
    />
  </div>

  <div class="container-page grid gap-12 pb-16 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16 md:pb-24">
    <aside class="lg:order-2">
      <div class="bg-brume p-6 md:p-7 lg:sticky lg:top-24">
        {
          p.statut === 'livre' ? (
            <p class="titre text-2xl leading-snug">{t.programme.soldOut}</p>
          ) : (
            <p>
              <span class="text-sm font-medium text-encre-600">{t.common.from}</span>
              <span class="titre block text-[2.1rem] leading-tight">{fcfa(p.prixMin, lang)}</span>
              <span class="text-sm text-encre-600">≈ {eur(p.prixMin, lang)}</span>
            </p>
          )
        }
        <dl class="mt-5 space-y-3 border-t border-brume-300 pt-5 text-[0.95rem]">
          <div>
            <dt class="text-sm text-encre-600">{t.programme.available}</dt>
            <dd class="flex items-center gap-2 font-semibold">
              <span class:list={['dot', p.disponibles ? 'dot-disponible' : 'dot-vendu']}></span>
              {t.availability(p.disponibles, p.total)}
            </dd>
          </div>
          <div>
            <dt class="text-sm text-encre-600">{t.programme.typology}</dt>
            <dd class="font-semibold">{tr(p.typologie, lang)}</dd>
          </div>
          <div>
            <dt class="text-sm text-encre-600">{t.programme.delivery}</dt>
            <dd class="font-semibold">{tr(p.livraison, lang)}</dd>
          </div>
        </dl>
        <div class="mt-6 grid gap-3">
          <WhatsAppButton message={waMessage} label={t.wa.write} />
          <a href={visitUrl} class="btn btn-outline">{t.common.visit}</a>
        </div>
        {
          p.chantier && (
            <a href={`${href(lang, 'avancement')}#${p.slug}`} class="link mt-5 inline-flex items-center gap-2">
              <Icon name="hard-hat" size={18} />
              {t.programme.followSite}
            </a>
          )
        }
      </div>
    </aside>

    <div class="min-w-0 space-y-16 lg:order-1 md:space-y-20">
      <section>
        <h2 class={h2}>{t.programme.about}</h2>
        <div class="max-w-2xl space-y-4 text-[1.075rem] leading-relaxed">
          {p.description[lang].map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section>
        <h2 class={h2}>{t.programme.features}</h2>
        <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
          {
            p.atouts.map((a) => (
              <li class="flex items-start gap-3 border-b border-brume-300 pb-4">
                <Icon name={a.icone} size={22} class="mt-0.5 text-encre" />
                <span class="font-medium">{a[lang]}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 class={h2}>{t.programme.location}</h2>
        <div class="grid gap-8 md:grid-cols-[1.25fr_1fr]">
          <figure>
            <LocationMap lang={lang} lat={p.localisation.lat} lng={p.localisation.lng} label={p.nom} />
            <figcaption class="mt-2 text-sm text-encre-600">{t.common.mapNote}</figcaption>
          </figure>
          <div>
            <p class="text-[1.075rem] font-medium">{tr(p.localisation.texte, lang)}</p>
            <h3 class="mt-6 text-[0.8125rem] font-normal tracking-normal text-encre-600">{t.programme.nearby}</h3>
            <ul class="mt-2 space-y-2">
              {
                p.localisation.proximites.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <Icon name="check" size={18} class="mt-1 text-dispo" />
                    <span>{tr(item, lang)}</span>
                  </li>
                ))
              }
            </ul>
            <a
              href={mapsUrl(p.localisation.mapsQuery)}
              target="_blank"
              rel="noopener"
              class="link mt-6 inline-flex items-center gap-2"
            >
              {t.common.openMaps}
              <Icon name="external-link" size={16} />
            </a>
          </div>
        </div>
      </section>

    </div>
  </div>

  <div class="bg-brume">
    <div class="container-page section space-y-16 md:space-y-20">
      <section class="grid gap-8 lg:grid-cols-[1fr_1.7fr] lg:gap-20">
        <div>
          <h2 class="h-sub">{t.programme.plan}</h2>
          <p class="mt-4 text-encre-600">{t.programme.planText}</p>
        </div>
        <SitePlan lang={lang} programme={p} />
      </section>

      <section id="unites">
        <h2 class={h2}>{t.programme.units}</h2>
        <UnitsTable lang={lang} programme={p} />
      </section>
    </div>
  </div>

  <div class="container-page section grid gap-16 lg:grid-cols-2 lg:gap-20">
      <section>
        <h2 class={h2}>{t.programme.payment}</h2>
        <div class="bg-brume p-6 md:p-8">
          <ul class="space-y-3 text-[1.05rem]">
            {
              p.paiement[lang].map((line) => (
                <li class="flex items-start gap-3">
                  <Icon name="wallet" size={20} class="mt-1 text-encre" />
                  <span>{line}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-5 text-sm text-encre-600">{t.programme.paymentNote}</p>
        </div>
      </section>

      <section>
        <h2 class={h2}>{t.programme.documents}</h2>
        <div class="grid gap-4">
          <a
            href={`/brochures/${p.brochure}`}
            download
            class="group flex items-center gap-4 border border-brume-300 bg-white p-5 hover:border-encre"
          >
            <span class="grid h-12 w-12 flex-none place-items-center rounded-full bg-encre text-white">
              <Icon name="download" size={22} />
            </span>
            <span>
              <span class="block font-semibold decoration-current decoration-2 underline-offset-4 group-hover:underline">
                {t.programme.brochure}
              </span>
              <span class="text-sm text-encre-600">{t.programme.brochureMeta}</span>
            </span>
          </a>
          <div class="flex items-start gap-4 border border-brume-300 bg-white p-5">
            <span class="grid h-12 w-12 flex-none place-items-center rounded-full bg-brume text-encre">
              <Icon name="file-check" size={22} />
            </span>
            <span>
              <span class="block font-semibold">{t.programme.titleDeed}</span>
              <span class="text-sm text-encre-600">{t.programme.titleDeedText}</span>
            </span>
          </div>
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <WhatsAppButton message={waMessage} label={t.wa.write} />
          <a href={visitUrl} class="btn btn-primary">{t.common.visit}</a>
        </div>
      </section>
  </div>

  <section class="section bg-brume">
    <div class="container-page">
      <h2 class="h-section">{t.programme.others}</h2>
      <div class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((o) => <ProgrammeCard lang={lang} programme={o} />)}
      </div>
    </div>
  </section>
</Base>
