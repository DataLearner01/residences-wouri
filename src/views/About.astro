---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import Tone from '../components/Tone.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../config/site';
import { fill, tr, useT, type Lang } from '../i18n';
import { addressLine, fcfa } from '../lib/format';
import equipe from '../content/equipe.json';
import partenaires from '../content/partenaires.json';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}

const { lang, alternates } = Astro.props;
const t = useT(lang);
const a = t.about;
const lowerFirst = (text: string) => text.charAt(0).toLowerCase() + text.slice(1);
const legalRows = [
  [a.legalRows.form, site.legal.form],
  [a.legalRows.capital, fcfa(site.legal.capital, lang)],
  [a.legalRows.rccm, site.legal.rccm],
  [a.legalRows.niu, site.legal.niu],
  [a.legalRows.seat, addressLine()],
];
---

<Base
  lang={lang}
  title={a.metaTitle}
  description={a.metaDescription}
  alternates={alternates}
  waMessage={t.wa.msg.about}
  current="about"
>
  <PageHead title={a.title} intro={a.intro} />

  <section class="section">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2 lg:gap-20">
      <div>
        <h2 class="h-section"><Tone text={a.storyTitle} /></h2>
        <div class="mt-6 space-y-4 text-[1.075rem] leading-relaxed">
          {a.story.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <Img
        src="photo-a-remplacer-apropos-histoire.jpg"
        alt={a.storyAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 46vw, 92vw"
        class="aspect-[4/3] h-auto w-full bg-brume-200 object-cover"
      />
    </div>
  </section>

  <section class="bande-nuit section" data-pointeur="0.12" data-pointeur-saut>
    <div class="container-page">
      <h2 class="h-section"><Tone text={a.valuesTitle} /></h2>
      <ul class="mt-12 grid gap-10 md:mt-16 md:grid-cols-3 md:gap-12">
        {
          a.values.map((value) => (
            <li class="border-t border-white/20 pt-6">
              <h3 class="text-[1.9rem]">{value.title}</h3>
              <p class="ton-doux mt-3 max-w-sm">{value.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <SectionHead title={a.teamTitle} text={a.teamText} />
      {/* Chaque carte se lit comme une présentation : « Je suis Armelle Ndongo, directrice générale ». */}
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 md:mt-14">
        {
          equipe.map((member) => (
            <li class="flex flex-col bg-brume p-7 md:p-10">
              <h3 class="equipe-nom flex-1">
                <span class="ton-clair">{t.common.memberIntro}</span>{' '}
                <Img
                  src={member.photo}
                  alt=""
                  widths={[96, 160]}
                  sizes="3rem"
                  class="mx-[0.08em] inline-block h-[1.02em] w-[1.02em] rounded-full bg-brume-300 object-cover object-top align-[-0.14em]"
                />{' '}
                {member.prenom} {member.nom}<span class="ton-clair">, {lowerFirst(tr(member.role, lang))}</span>
              </h3>
              <p class="mt-8 text-sm text-encre-600">WhatsApp {site.whatsapp.display}</p>
              <WhatsAppButton
                message={fill(t.wa.msg.member, { prenom: member.prenom })}
                number={member.whatsapp}
                label={fill(a.writeTo, { prenom: member.prenom })}
                class="mt-3 w-full"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-brume">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.7fr] lg:gap-20">
      <div>
        <h2 class="h-section"><Tone text={a.partnersTitle} /></h2>
        <p class="mt-4 text-encre-600">{a.partnersText}</p>
      </div>
      <ul class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
        {
          partenaires.map((partner) => (
            <li class="flex gap-4">
              <span class="grid h-12 w-12 flex-none place-items-center rounded-full bg-brume-200 text-encre">
                <Icon name={partner.icone} size={22} />
              </span>
              <div>
                <h3 class="text-[1.3rem] leading-tight">{tr(partner.titre, lang)}</h3>
                <p class="mt-1.5 text-encre-600">{tr(partner.texte, lang)}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.7fr] lg:gap-20">
      <div>
        <h2 class="h-section"><Tone text={a.legalTitle} /></h2>
        <p class="mt-5 inline-flex items-center gap-2 bg-brume px-3 py-1.5 text-sm font-semibold">
          <Icon name="info" size={16} />
          {a.legalDemo}
        </p>
      </div>
      <dl class="border-t border-brume-300">
        {
          legalRows.map(([label, value]) => (
            <div class="grid gap-1 border-b border-brume-300 py-4 sm:grid-cols-[14rem_1fr] sm:gap-6">
              <dt class="text-encre-600">{label}</dt>
              <dd class="font-semibold">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Base>

<style>
  .equipe-nom {
    font-size: clamp(1.6rem, 2.7vw, 2.4rem);
    line-height: 1.12;
  }
</style>
