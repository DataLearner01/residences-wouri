---
// Plan de masse en SVG. Aucune logique métier : positions et couleurs viennent du fichier de données.
//  - plan.type « etages » : un dessin par bâtiment, une ligne par étage.
//  - plan.type « lots »   : une grille de lots par groupe, séparés par des voies.
import { fill, tr, useT, type Lang } from '../i18n';
import type { Programme, Unite } from '../lib/content';

interface Props {
  lang: Lang;
  programme: Programme;
}

const { lang, programme: p } = Astro.props;
const t = useT(lang);
const short = (ref: string) => ref.split('-').pop() ?? ref;
const planLabel = fill(t.programme.planAria, { nom: p.nom });

type Cell = { u: Unite; x: number; y: number; w: number; h: number };

// --- Bâtiments par étages ---
const buildings =
  p.plan.type === 'etages'
    ? p.plan.groupes.map((groupe) => {
        const units = p.unites.filter((u) => u.groupe === groupe.cle);
        const floors = [...new Set(units.map((u) => u.rang ?? 0))].sort((a, b) => b - a);
        const onFloor = (f: number) => units.filter((u) => (u.rang ?? 0) === f);
        const cols = Math.max(...floors.map((f) => onFloor(f).length));
        const cw = 64, ch = 40, gap = 6, gutter = 40, roof = 16, foot = 14;
        const cells: Cell[] = floors.flatMap((f, row) =>
          onFloor(f).map((u, col) => ({ u, x: gutter + gap + col * (cw + gap), y: roof + gap + row * (ch + gap), w: cw, h: ch })),
        );
        return {
          groupe,
          gutter,
          roof,
          foot,
          width: gutter + cols * (cw + gap) + gap,
          height: roof + floors.length * (ch + gap) + gap + foot,
          cells,
          labels: floors.map((f, row) => ({ text: t.floorShort(f), y: roof + gap + row * (ch + gap) + ch / 2 })),
        };
      })
    : [];

// --- Lots ---
const lots = (() => {
  if (p.plan.type !== 'lots') return null;
  const big = p.plan.taille === 'grand';
  const cw = big ? 98 : 56, ch = big ? 78 : 50, gap = 4, cols = p.plan.colonnes ?? 5;
  const road = 26, left = road + 10, labelH = 20;
  let y = 6;
  const blocks = p.plan.groupes.map((groupe, gi) => {
    const units = p.unites.filter((u) => u.groupe === groupe.cle);
    const rows = Math.ceil(units.length / cols);
    const top = y;
    const cells: Cell[] = units.map((u, i) => ({
      u,
      x: left + (i % cols) * (cw + gap),
      y: top + labelH + Math.floor(i / cols) * (ch + gap),
      w: cw,
      h: ch,
    }));
    y = top + labelH + rows * (ch + gap) + 6;
    const roadY = gi < p.plan.groupes.length - 1 ? y : null;
    if (roadY !== null) y += road + 6;
    return { groupe, top, cells, roadY };
  });
  return { blocks, road, left, width: left + cols * (cw + gap) + 2, height: y + 4 };
})();

const legend = [
  ['disponible', p.disponibles],
  ['reserve', p.reserves],
  ['vendu', p.vendus],
] as const;
---

<div class="plan">
  {
    buildings.length > 0 && (
      <div class="flex flex-wrap gap-x-10 gap-y-8">
        {buildings.map((b) => (
          <figure>
            <svg
              viewBox={`0 0 ${b.width} ${b.height}`}
              width={b.width}
              height={b.height}
              class="h-auto max-w-full"
              role="group"
              aria-label={`${planLabel} : ${tr(b.groupe, lang)}`}
            >
              <rect x={b.gutter - 4} y={b.roof - 7} width={b.width - b.gutter + 4} height="7" class="plan-roof" />
              <rect x={b.gutter} y={b.roof} width={b.width - b.gutter} height={b.height - b.roof - b.foot} class="plan-wall" />
              <rect x="0" y={b.height - b.foot} width={b.width} height="3" class="plan-roof" />
              {b.labels.map((l) => (
                <text x={b.gutter - 8} y={l.y} class="plan-note" text-anchor="end" dominant-baseline="central">
                  {l.text}
                </text>
              ))}
              {b.cells.map((c) => (
                <a href={`#u-${c.u.ref}`} class={`cell cell-${c.u.statut}`} aria-label={`${c.u.ref}, ${t.unitStatus[c.u.statut]}`}>
                  <rect x={c.x} y={c.y} width={c.w} height={c.h} rx="2" />
                  <text x={c.x + c.w / 2} y={c.y + c.h / 2} text-anchor="middle" dominant-baseline="central">
                    {short(c.u.ref)}
                  </text>
                </a>
              ))}
            </svg>
            <figcaption class="mt-1 text-sm font-semibold">{tr(b.groupe, lang)}</figcaption>
          </figure>
        ))}
      </div>
    )
  }

  {
    lots && (
      <svg
        viewBox={`0 0 ${lots.width} ${lots.height}`}
        width={lots.width}
        height={lots.height}
        class="h-auto w-full max-w-[32rem]"
        role="group"
        aria-label={planLabel}
      >
        <rect x="0" y="0" width={lots.road} height={lots.height} class="plan-road" />
        <line x1={lots.road / 2} y1="6" x2={lots.road / 2} y2={lots.height - 6} class="plan-road-line" />
        {lots.blocks.map((block, i) => (
          <g>
            <text x={lots.left} y={block.top + 13} class="plan-title">
              {tr(block.groupe, lang)}
            </text>
            {block.roadY !== null && (
              <>
                <rect x={lots.road} y={block.roadY} width={lots.width - lots.road} height={lots.road} class="plan-road" />
                <line
                  x1={lots.road + 4}
                  y1={block.roadY + lots.road / 2}
                  x2={lots.width - 4}
                  y2={block.roadY + lots.road / 2}
                  class="plan-road-line"
                />
                {i === 0 && p.plan.voie && (
                  <text
                    x={(lots.road + lots.width) / 2}
                    y={block.roadY + lots.road / 2}
                    class="plan-road-name"
                    text-anchor="middle"
                    dominant-baseline="central"
                  >
                    {tr(p.plan.voie, lang)}
                  </text>
                )}
              </>
            )}
            {block.cells.map((c) => (
              <a href={`#u-${c.u.ref}`} class={`cell cell-${c.u.statut}`} aria-label={`${c.u.ref}, ${t.unitStatus[c.u.statut]}`}>
                <rect x={c.x} y={c.y} width={c.w} height={c.h} rx="2" />
                <text x={c.x + c.w / 2} y={c.y + c.h / 2} text-anchor="middle" dominant-baseline="central">
                  {short(c.u.ref)}
                </text>
              </a>
            ))}
          </g>
        ))}
      </svg>
    )
  }

  <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
    {
      legend.map(([statut, count]) => (
        <li class="flex items-center gap-2">
          <span class={`dot dot-${statut}`} />
          {t.unitStatus[statut]} ({count})
        </li>
      ))
    }
  </ul>
</div>

<style>
  .plan svg {
    font-family: var(--font-sans);
  }
  .plan-roof {
    fill: var(--color-encre);
  }
  .plan-wall {
    fill: #fff;
    stroke: var(--color-brume-300);
  }
  .plan-road {
    fill: var(--color-brume-200);
  }
  .plan-road-line {
    stroke: #fff;
    stroke-width: 2;
    stroke-dasharray: 8 8;
  }
  .plan-road-name {
    fill: var(--color-encre-600);
    font-size: 10px;
    font-weight: 700;
    paint-order: stroke;
    stroke: var(--color-brume-200);
    stroke-width: 6px;
  }
  .plan-note {
    fill: var(--color-encre-600);
    font-size: 12px;
    font-weight: 600;
  }
  .plan-title {
    fill: var(--color-encre);
    font-size: 12px;
    font-weight: 800;
  }
  .cell text {
    font-size: 12.5px;
    font-weight: 700;
    pointer-events: none;
  }
  .cell rect {
    stroke: transparent;
    stroke-width: 2;
  }
  .cell:hover rect,
  .cell:focus-visible rect {
    stroke: var(--color-encre);
  }
  .cell:focus-visible {
    outline: none;
  }
  .cell-disponible rect {
    fill: var(--color-dispo);
  }
  .cell-disponible text {
    fill: #fff;
  }
  .cell-reserve rect {
    fill: var(--color-or);
  }
  .cell-reserve text {
    fill: var(--color-encre);
  }
  .cell-vendu rect {
    fill: var(--color-brume-300);
  }
  .cell-vendu text {
    fill: var(--color-encre-600);
  }
</style>
