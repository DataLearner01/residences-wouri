---
// En-tête des pages intérieures : grand titre en deux tons sur fond blanc.
import Tone from './Tone.astro';

interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<section>
  <div class="container-page pb-10 pt-32 md:pb-14 md:pt-44">
    <slot name="before" />
    <h1 class="h-page max-w-5xl"><Tone text={title} /></h1>
    {intro && <p class="lead mt-6 max-w-2xl"><Tone text={intro} soft auto /></p>}
    <slot />
  </div>
</section>
